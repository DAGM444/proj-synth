# ==========================================
# Proj-Synth Environment Configuration
# ==========================================

# Port Configuration
PORT=5000
FRONTEND_PORT=80

# Security
JWT_SECRET=proj-synth-super-secret-jwt-key-2026

# Allowed CORS Origins (comma-separated if multiple)
CLIENT_URL=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# Frontend API URL (defaults to /api for nginx reverse proxy in production)
VITE_API_BASE_URL=/api

# Database Configuration
# Default: SQLite
DATABASE_URL="file:./dev.db"

# PostgreSQL Configuration (if switching from SQLite to PostgreSQL)
# 1. In server/prisma/schema.prisma: change provider to "postgresql"
# 2. Uncomment and use the PostgreSQL DATABASE_URL below:
# DATABASE_URL="postgresql://synth:synthpassword@postgres:5432/synthdb?schema=public"
POSTGRES_USER=synth
POSTGRES_PASSWORD=synthpassword
POSTGRES_DB=synthdb
POSTGRES_PORT=5432
