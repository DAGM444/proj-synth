generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Playlist {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  tracks      Track[]
}

model Track {
  id          String   @id @default(uuid())
  videoId     String
  title       String
  artist      String
  duration    String
  thumbnail   String
  playlistId  String
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
}